# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Xcode — données locales et produits de compilation
DerivedData/
build/
*.xcarchive
*.dSYM
*.dSYM.zip
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.moved-aside

# Swift Package Manager
.build/
.swiftpm/

# Secrets et configuration locale
.env
.env.*
!.env.example
*.mobileprovision
*.provisionprofile

# Fichiers temporaires des éditeurs
*~
*.swp
*.swo

# Secrets de publication — ne jamais committer
# Clés et certificats
*.p8
*.p12
*.pem
*.key
*.cer
*.certSigningRequest
AuthKey_*
# Clés privées Sparkle exportées
*sparkle*private*
*.ed25519
eddsa_*
# Site (Wrangler)
.dev.vars
.dev.vars.*
.wrangler/
node_modules/
# Feuille compilée par Tailwind (npm run --prefix site build)
site/public/style.css
# Artefacts de publication
dist/
*.dmg
/*.app/
notarization-*.json
notarytool-*.log
docs/assets/brand/out/
# Impeccable : le binaire du moteur se télécharge par machine (version dans
# scripts/VERSION), et l’état de session reste local.
.claude/skills/impeccable/scripts/bin/
.agents/skills/impeccable/scripts/bin/
site/.impeccable/*
!site/.impeccable/config.json
